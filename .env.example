# Public address of the site, used for canonical links, the sitemap and share previews.
# Defaults to https://telemetry-one.com when unset.
NEXT_PUBLIC_SITE_URL=

# OpenF1 sponsor account, needed only to show sessions while they are running (En directo).
# Finished sessions (Repetición, Telemetría) work without it. https://openf1.org
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Alternative to username/password: a token you already obtained.
OPENF1_API_TOKEN=

# Secret Vercel sends to /api/cron/post-race. Without it the weekly refresh of the model returns 401.
CRON_SECRET=

# Accounts (Google sign-in, follows, saved game progress). All four are needed; without them
# the "Ingresar" button and every account widget stay hidden.
# AUTH_SECRET: any long random string (`npx auth secret` prints one).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: OAuth client from Google Cloud Console, with the redirect URI
#   https://telemetry-one.com/api/auth/callback/google
# DATABASE_URL: Neon Postgres (Vercel Marketplace sets it). Tables are created on first use.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
DATABASE_URL=
